        "jsCode": "// Fungsi untuk menghasilkan 5 huruf acak (kombinasi huruf kecil & besar)\nfunction randomString(length = 5) {\n  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';\n  let result = '';\n  for (let i = 0; i < length; i++) {\n    result += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n  return result;\n}\n\n// Output langsung tanpa $input.all()\nconst item = {};\n\n// Tambahkan sedikit entropi waktu agar probabilitas duplikat lebih kecil\nconst seed = (Date.now() + Math.random()).toString(36);\nconst mix = seed.charAt(seed.length - 1); // ambil 1 karakter acak berbasis waktu\n\nitem.myNewField = randomString(4) + mix; // total tetap 5 karakter\n\nreturn item;\n"
      },
